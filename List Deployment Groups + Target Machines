function Get-AzDoDeploymentGroups {
    param(
        [Parameter(Mandatory)][string]$Organization,
        [Parameter(Mandatory)][string]$Project,
        [string]$Pat = $env:AZDO_PAT
    )

    $headers = Get-AzDoHeaders -Pat $Pat
    $uri = "https://dev.azure.com/$Organization/$Project/_apis/distributedtask/deploymentgroups?api-version=7.1&`$expand=machines"

    $groups = Invoke-RestMethod -Uri $uri -Headers $headers

    foreach ($g in $groups.value) {
        Write-Host "`nDeployment Group: $($g.name) (ID: $($g.id))  |  Machines: $($g.machines.Count)" -ForegroundColor Cyan

        $g.machines | Select-Object `
            @{N='AgentId';E={$_.agent.id}},
            @{N='Name';E={$_.agent.name}},
            @{N='Status';E={$_.agent.status}},
            @{N='Enabled';E={$_.agent.enabled}},
            @{N='Version';E={$_.agent.version}},
            @{N='Tags';E={$_.tags -join ", "}} |
        Format-Table -AutoSize
    }
}
