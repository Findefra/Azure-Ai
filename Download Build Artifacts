function Get-AzDoBuildArtifact {
    param(
        [Parameter(Mandatory)][string]$Organization,
        [Parameter(Mandatory)][string]$Project,
        [Parameter(Mandatory)][int]$BuildId,
        [string]$ArtifactName,                           # Optional – downloads all if omitted
        [string]$DestinationPath = ".\artifacts",
        [string]$Pat = $env:AZDO_PAT
    )

    $headers = Get-AzDoHeaders -Pat $Pat

    $artifactsUri = "https://dev.azure.com/$Organization/$Project/_apis/build/builds/$BuildId/artifacts?api-version=7.1"
    $artifacts = Invoke-RestMethod -Uri $artifactsUri -Headers $headers

    if (-not (Test-Path $DestinationPath)) {
        New-Item -ItemType Directory -Path $DestinationPath | Out-Null
    }

    foreach ($artifact in $artifacts.value) {
        if ($ArtifactName -and $artifact.name -ne $ArtifactName) { continue }

        $downloadUrl = $artifact.resource.downloadUrl
        $outFile = Join-Path $DestinationPath "$($artifact.name).zip"

        Write-Host "Downloading artifact '$($artifact.name)'..." -ForegroundColor Cyan
        Invoke-RestMethod -Uri $downloadUrl -Headers $headers -OutFile $outFile
        Write-Host "Saved to $outFile" -ForegroundColor Green
    }
}
